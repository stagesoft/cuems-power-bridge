<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-rewritten to doc_version="2" (feature 013 device reshape: players wrapped
     with a class attribute; F3: audio_cards/universes retired), because the
     automatic cuems-reshape-devices tool cannot carry a pre-013 document across
     both changes at once: its registered settings 1->2 converter only matches
     the old flat <audioplayer>/<dmxplayer> path and never sees a reshaped
     <players><player> (cuems-utils specs/planning/settings-reshape-defeats-f3-
     conversion-defect.md). Same treatment cuems-nodeconf applied to its own
     fixture for the identical reason. -->
<cms:CuemsSettings xmlns:cms="https://stagelab.coop/cuems/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://stagelab.coop/cuems/ ../cuems/settings.xsd" doc_version="2">
    <Settings>
        <conf_path>/etc/cuems</conf_path>
        <library_path>/opt/cuems_library</library_path>
        <tmp_path>/tmp/cuems</tmp_path>
        <database_name>project-manager.db</database_name>
        <show_lock_file>show.lock</show_lock_file>
        <editor_url>formitgo.local</editor_url>
        <controller_url>controller.local</controller_url>
        <templates_path>/usr/share/cuems</templates_path>
        <controller_interfaces_template>interfaces.controller</controller_interfaces_template>
        <node_interfaces_template>interfaces.node</node_interfaces_template>
        <controller_lock_file>controller.lock</controller_lock_file>
        <node>
            <uuid>0367f391-ebf4-48b2-9f26-000000000001</uuid>
            <mac>2cf05d21cca3</mac>
            <osc_dest_host>localhost</osc_dest_host>
            <oscquery_ws_port>9190</oscquery_ws_port>
            <oscquery_osc_port>9191</oscquery_osc_port>
            <websocket_port>9092</websocket_port>
            <load_timeout>15000</load_timeout>
            <nodeconf_timeout>5000</nodeconf_timeout>
            <discovery_timeout>15000</discovery_timeout>
            <mtc_port>Midi Through Port-0</mtc_port>
            <osc_in_port_base>7000</osc_in_port_base>
            <nng_hub_port>9093</nng_hub_port>
            <gradient_osc_port>7100</gradient_osc_port>
            <players>
                <player class="video">
                    <path>/usr/bin/xjadeo</path>
                    <args>--ontop --fullscreen --no-splash --quiet --no-initial-sync --midi-driver alsa-seq --ignore-file-offset</args>
                    <outputs>2</outputs>
                    <output_latency_ms>33</output_latency_ms>
                </player>
                <player class="audio">
                    <path>/usr/local/bin/cuems-audioplayer</path>
                    <args>-w -1</args>
                    <output_latency_ms>auto</output_latency_ms>
                </player>
                <player class="dmx">
                    <path>/usr/bin/cuems-dmxplayer</path>
                    <args>--mtcfollow</args>
                    <!-- output_latency_ms absent: dmx does NOT accept "auto"
                         (no self-measurement path; schema rejects it).
                         Absent = 35 ms hard-coded default in the binary.
                         Typical per-adapter starting points when operators
                         set an integer:
                           ENTTEC/DMXKing ~30 ms, OpenDMX ~35 ms,
                           ArtNet ~44 ms (dedicated LAN) / 60-80 ms (shared). -->
                </player>
            </players>
            <audiomixer>
                <path>/usr/local/bin/jack-volume</path>
                <args></args>
            </audiomixer>
        </node>
    </Settings>
</cms:CuemsSettings>
