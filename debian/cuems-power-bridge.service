[Unit]
Description=CUEMS power bridge (Shelly + Companion shutdown coordinator)
After=network-online.target cuems-controller-engine.service cuems-editor.service
Wants=network-online.target cuems-editor.service
# Deliberately NOT PartOf=cuems-controller.target: bridge must survive
# engine restarts so the engine_state cache can reconnect with backoff
# and the auto-load loop can recover.

[Service]
Type=notify
NotifyAccess=main
User=cuems
Group=cuems
ExecStart=/usr/lib/cuems/bin/cuems-power-bridge
Restart=on-failure
RestartSec=3
SyslogIdentifier=cuems-power-bridge
# The NDI preview (/ndi/*) reads the videocomposers' answers from the journal:
# the local one (systemd-journal) and the nodes' uploaded ones under
# /var/log/journal/remote (systemd-journal-remote). Both groups exist wherever
# cuems-common is installed (it depends on systemd-journal-remote); a missing
# one fails the unit with 216/GROUP — the postinst checks. This gives the
# bridge, a network-facing process, read access to every host's journal.
SupplementaryGroups=systemd-journal systemd-journal-remote
# Need to exec ssh and sudo systemctl poweroff — leave most defaults open.
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/etc/cuems
PrivateTmp=no

[Install]
WantedBy=cuems-controller.target
