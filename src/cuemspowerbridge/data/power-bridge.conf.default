#
# cuems-power-bridge default configuration
# Shipped at /usr/share/cuems/power-bridge.conf.default; the bridge falls
# back to these values when /etc/cuems/power-bridge.conf is missing.
# Operator-edited config lives at /etc/cuems/power-bridge.conf and
# overrides the values here.

# --- Network topology (multi-subnet) ---
# shelly_url, projector.N.host and the cluster nodes may each live on a
# DIFFERENT subnet/interface. The bridge makes plain outbound TCP/HTTP
# connections and does NOT pin an interface — the kernel routes by
# destination IP. So separate subnets "just work" as long as the
# controller has a route to each: give it an interface (or static route)
# on every subnet via /etc/cuems network config (/etc/network/interfaces),
# then set the IPs below accordingly. Example — projectors on their own
# AV-control LAN, Shelly on another:
#   # /etc/network/interfaces
#   auto eth2                      # projector LAN
#   iface eth2 inet static
#       address 192.168.10.1/24
#   auto eth3                      # Shelly LAN
#   iface eth3 inet static
#       address 192.168.20.1/24
# Then: shelly_url = http://192.168.20.50 and projector.1.host = 192.168.10.21
# Verify routing picks the right NIC:  ip route get 192.168.10.21
# Verify reachability:  cuems-power-bridge-test-projector 192.168.10.21 status
#                       curl http://192.168.20.50/rpc/Shelly.GetStatus
# (Only if routing is AMBIGUOUS — overlapping ranges, multiple paths, or a
# device that filters by source IP — would the bridge need source-address
# binding; it does not today. Raise it if you hit that case.)

# --- Shelly endpoint ---
shelly_url = http://192.168.6.2          # IP, not .local (Shelly's DNS is unreliable)
shelly_username =                         # optional digest auth user
shelly_password =                         # optional digest auth password
shelly_switch_id = 0

# --- Safety ---
refuse_if_running = true                  # 409 on shutdown while project is playing
shutdown_max_wait_s = 180                 # arm timer + poweroff anyway after this many seconds
shelly_safety_timer_s = 60                # Shelly hardware timer (valid range 45..300)

# --- Engine + editor channels ---
engine_ws_url = ws://localhost:9190       # binary OSC: status + GO/STOP
editor_ws_url = ws://localhost:9092       # JSON: project_ready for auto-load
auto_load_project =                       # UUID; empty = no auto-load
auto_load_persistent = false              # false = once per bridge process; true = re-arm on every empty-load
auto_play = false                         # true = send GO automatically once an auto-loaded project arms (needs auto_load_project)

# --- Auto-load node-readiness gate ---
# Boot-time auto-load is fragile against slow/late nodes. The engine freezes
# its required-node set from a single ~1.5 s NNG liveness probe at load time
# and starts a 120 s arm watchdog; a node not yet on the bus at that instant
# is silently EXCLUDED (GO then blocked, needing a manual engine restart).
#
# READINESS MODEL: node-engines are NNG Bus0 CLIENTS of the controller's hub
# (port from <nng_hub_port> in settings.xml). The bridge runs on the
# controller and reads its own socket table (`ss`, no root) to see which node
# IPs are connected to that hub — exactly what the engine's probe counts as
# "alive". So we WAIT until the expected node-engines are on the hub before
# firing project_ready, then require armed==yes (not merely loaded) and retry.
#
# <ip> LIMITATION: matching is by network_map.xml <ip> (operator-maintained,
# nodeconf disabled). A missing <ip> skips that node; a STALE <ip> never
# matches — covered by a count-based fallback (when waiting for ALL slaves:
# enough distinct bus peers ⇒ proceed) and, failing that, a graceful
# degraded-proceed after the timeout. It never hangs.
auto_load_wait_nodes = true               # false ≈ legacy path (but success still needs armed==yes)
auto_load_node_ids =                      # CSV of role_ids to wait for; empty = ALL adopted slaves
auto_load_node_timeout_s = 420            # max wait for node-engines on the bus (covers fsck) → then DEGRADED-proceed
auto_load_node_settle_s = 10              # margin after bus-connect before loading
auto_load_armed_timeout_s = 150           # wait for armed==yes (> engine's 120 s arm watchdog; min 30)
auto_load_max_attempts = 5                # soft attempts, then 30 s self-heal cadence (never disables)
# Note: nng_hub_port is NOT configured here — it is read from
# <nng_hub_port> in /etc/cuems/settings.xml (single source of truth).
#
# Operator loads/unloads (POST /loadproject, /unloadproject) and auto-load:
# loading ANOTHER project, or unloading, suspends auto-load until the bridge
# restarts (otherwise a persistent loop would reload behind the operator).
# Loading the auto_load_project itself keeps auto-load and counts as its
# load. /status.auto_load.disabled_reason says why auto-load stopped.

# --- Load / unload over HTTP (POST /loadproject, /unloadproject) ---
# How long one operation is tracked before /status reports it overdue (and a
# ?wait=1 caller gets 504). Covers the editor's worst case (a media re-index,
# ~6 min) plus arming. Clamped to 60..3600; an invalid value means 450.
project_op_timeout_s = 450

# --- Companion cue-status relay (UDP OSC) ---
# Re-sends the engine's /engine/status/* frames to Bitfocus Companion's
# Generic OSC module (UDP), plus /cuems/bridge/engine_connected (link state,
# every 2 s) and the edge pulses /cuems/bridge/cue_started/<uuid> and
# /cuems/bridge/cue_ended/<uuid> (0 -> 1 -> 0) for "when cue X ends" triggers.
# Companion asks for a full re-send with /cuems/bridge/dump on the listen port.
# Controller only; OFF unless osc_relay_targets is set. Shown commented out:
# the values are the code defaults. See README "Companion cue-status relay".
# A bad value never stops the bridge: bad targets/keys disable the relay
# (logged, /status osc_relay.last_error), rate/refresh fall back or clamp.
#osc_relay_targets = 127.0.0.1:8480        # CSV of IP:port, literal IPs only (no .local)
#osc_relay_listen = 127.0.0.1:8478         # UDP; Companion sends /cuems/bridge/dump here; empty = off
#osc_relay_keys = cue/,running,armed,load,nextcue  # "x/" = prefix; opt-in: cue_enabled/, cue_name/
#osc_relay_refresh_s = 0                   # periodic full re-send; 0 = off, else >= 30
#osc_relay_rate = 1000                     # datagrams per second (100..8000)

# --- Operational ---
dry_run = false                           # true = log side-effects without executing
unresolvable_nodes_policy = skip          # nodes with no role_id/alias/hostname: log ERROR + skip

# --- SSH to nodes ---
ssh_user = cuems-admin
ssh_key = /etc/cuems/power-bridge.key
poweroff_cmd = sudo /sbin/poweroff
# Optional split for the local controller. Empty → use poweroff_cmd above.
# Set to "sudo /usr/bin/systemctl reboot" for safe unattended testing: the
# controller cycles back on its own (nodes really power off) without relying
# on Wake-on-LAN or a physical power-on. WoL-from-S5 IS verified working on
# this cluster's Realtek r8169 NICs (re-armed each boot by cuems-arm-wol),
# though r8169 WoL can be flaky across hardware generally.
controller_poweroff_cmd =

# --- HTTP bind ---
listen_host = 0.0.0.0                     # Shelly + Companion both reach this
listen_port = 8478
shared_token =                            # optional X-Auth-Token header; recommended on LAN deploys

# --- network_map ---
network_map_path = /etc/cuems/network_map.xml

# --- Projectors / displays ---
# The bridge powers projectors ON when a project loads and OFF during the
# orderly /shutdown. driver=pjlink is the only protocol implemented (TCP
# 4352; works on Epson EB-690SU / EB-815E and most PJLink projectors).
# Power-ON from a fully-off projector needs "Standby Mode Communications =
# ON" (network standby) plus PJLink enabled on the projector.
projector_power_on_on_load = true        # power displays ON when a project loads
projector_power_off_on_shutdown = true   # power displays OFF during /shutdown
# Power displays ON at bridge startup too (independent of project load), so they
# warm up in parallel with the node-wait/auto-load. Also reachable on demand via
# POST /poweron. Fires on every service start (incl. restarts) — leave off if you
# need a manual /shutdown-off to persist across a bridge restart. Default off.
projector_power_on_on_start = false      # power displays ON at startup + enable POST /poweron-driven warmup
projector_command_timeout_s = 5          # per-command network timeout (> 0)

# One numbered block per device (1, 2, 3, ...). Uncomment + edit:
#   projector.1.host     = 10.16.10.21
#   projector.1.driver   = pjlink
#   projector.1.name     = Stage Left
#   projector.1.port     = 4352          # optional; pjlink default 4352
#   projector.1.password =               # optional; do NOT use '#' (parser strips it)
#   projector.2.host     = 10.16.10.22
#   projector.2.name     = Stage Right

# --- Brightness presets (optional, Epson ESC/VP21 over ESC/VP.net :3629) ---
# A no-op unless configured. Lets a single HTTP call (Companion-friendly) set a
# fixed brightness on the opted-in projectors, leaving every other unit alone:
#     POST /brightness?level=<name>     (X-Auth-Token header if shared_token set)
#   -> 200 all applied | 207 partial | 502 all failed | 400 unknown_level
#      | 503 no_brightness_devices
# Levels are install-defined: brightness.<name>.command = <ESC/VP21 verb+value>.
# The verb is whatever knob you want (BRIGHT = OSD "Brightness/Brillo", LUMINANCE
# = light-source mode, etc.). NOTE: brightness only applies while the projector
# is POWERED ON — in standby every ESC/VP21 set returns ERR (surfaced as 502).
#
#   brightness.standard.command = BRIGHT 0     # e.g. the dialed-down/eco value
#   brightness.full.command     = BRIGHT 50    # e.g. the normal/bright value
#
# Then opt specific devices into the brightness fleet (only these are touched):
#   projector.1.brightness      = true
#   projector.1.escvp_password  =              # ESC/VP.net password (may differ
#                                              # from the PJLink password above)
#   projector.1.escvp_port      = 3629         # optional; ESC/VP.net default 3629
# Requires "Command Communication" (ESC/VP.net) enabled on each projector's
# network menu — distinct from the PJLink toggle.

# ---------------------------------------------------------------------------
# NDI preview for montajes (/ndi/*, the page at /ndi/). All optional.
#
#   ndi_journal_stale_s = 600   # a node whose uploaded journal is older than
#                               # this (s) is "journal sin llegar": previews to
#                               # it are refused (503 journal_stale), since the
#                               # route and the confirmation both come from it.
#   ndi_hosts           = 10.20.0.15, 10.20.0.16
#                               # senders on ANOTHER subnet: the controller's
#                               # videocomposer asks these IPs directly (mDNS
#                               # does not cross routers). Up to 8; more can be
#                               # added from the page. Needs a videocomposer with
#                               # "ips=" in its discovery lines (after 0.1.2-7).
#   ndi_vc_osc_port     = 7000  # the videocomposers' OSC port
#   ndi_mappings_path   = /etc/cuems/default_mappings.xml   # screen names
